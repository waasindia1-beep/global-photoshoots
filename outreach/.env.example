# Copy this file to .env and fill in the real values.
# .env must never be committed or shared. send_outreach.py reads it automatically.

# Gmail (recommended to start): enable 2FA, then Google Account > Security > App passwords.
SMTP_USER=sudhir@globalphotoshoots.com
SMTP_PASS=your-16-character-app-password

# ⚠️ REQUIRED. CAN-SPAM requires a real postal address on every commercial email, and
# an inaccurate one is a legal and deliverability problem. Keep it identical to the
# address in ../config.js, your Google Business Profile and your Justdial listing —
# those get cross-checked against each other. The script refuses to send while this
# is still the placeholder.
SENDER_ADDRESS=your real postal address here

# Uncomment and adjust for other providers.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Other providers:
#   Outlook / Hotmail : smtp-mail.outlook.com : 587
#   Zoho              : smtp.zoho.com         : 465 (needs SSL)
#   Brevo / SendGrid  : use their API instead of this script